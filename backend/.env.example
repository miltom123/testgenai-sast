# ==============================================================================
#  TestGenAI Backend — Plantilla de variables de entorno (MVP Consolidado)
#  Copie este archivo a `.env` y complete los valores reales. NUNCA versione `.env`.
# ==============================================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development                 # development | test | production
LOG_LEVEL=info                       # fatal | error | warn | info | debug | trace | silent

# --- Base de Datos Relacional (PostgreSQL) ---
# Docker Compose local (docker compose up -d):
DATABASE_URL="postgresql://postgres:postgres_password_2026@localhost:5432/calidad_db?schema=public"
# O PostgreSQL gestionado (Supabase / Neon / Railway):
# DATABASE_URL="postgresql://usuario:clave@host:5432/db?sslmode=require"

# --- Seguridad y Sesión (Cookies HttpOnly) ---
# Clave secreta para JWT. En producción debe tener al menos 32 caracteres aleatorios.
JWT_SECRET="clave_secreta_jwt_para_desarrollo_local_min_32_chars"
JWT_REFRESH_SECRET="clave_secreta_refresh_desarrollo_local_min_32_chars"
ACCESS_TOKEN_EXPIRES_IN="1h"
REFRESH_TOKEN_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# --- CORS & Origen Seguro ---
# En desarrollo: "*" o "http://localhost:4000". En producción: URL pública de la aplicación.
CORS_ORIGINS="http://localhost:4000"

# --- Proveedor de Inteligencia Artificial Real ---
AI_PROVIDER_DEFAULT="gemini"          # gemini | openai (SOLO proveedores reales)
GEMINI_API_KEY=""                     # API Key oficial de Google AI Studio
OPENAI_API_KEY=""                     # API Key oficial de OpenAI (si se usa OpenAI)
AI_REQUEST_TIMEOUT_MS=30000           # Tiempo límite por llamada (ms)
AI_MAX_RETRIES=1                      # Reintentos máximos para errores transitorios
AI_PROJECT_BUDGET_USD=10              # Presupuesto límite estimado de IA por proyecto (USD)
